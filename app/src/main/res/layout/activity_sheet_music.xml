<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetMusicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SheetMusicActivity">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/psalm_toolbar" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/psalm_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/backToIndexButton"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/psalmPickerTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            app:drawableEndCompat="@drawable/ic_arrow_drop_down"
            app:drawableTint="@color/white"
            android:drawablePadding="0dp"
            android:text="@string/default_psalm"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/verseTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            app:drawableEndCompat="@drawable/ic_arrow_drop_down"
            app:drawableTint="@color/white"
            android:drawablePadding="0dp"
            android:text="@string/default_verse"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/sharePdfButton"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:scaleType="centerInside"
            android:contentDescription="@string/share_pdf" />

        <ImageButton
            android:id="@+id/playMelodyButton"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside"
            android:contentDescription="@string/play_melody" />

        <ImageButton
            android:id="@+id/optionsButton"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/lyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/controlsPanel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/textDownButton"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ctrl_button"
                    android:text="@string/decrease"
                    android:textColor="@color/app_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textScaleTextView"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/scale_default"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/textUpButton"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ctrl_button"
                    android:text="@string/increase"
                    android:textColor="@color/app_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/lyricsScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lyricsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp"
                        android:textColor="@color/app_text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/navigationPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/panel_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp">

                        <Button
                            android:id="@+id/prevVerseButton"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ctrl_button"
                            android:text="@string/previous"
                            android:textAllCaps="false"
                            android:textColor="@color/app_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/nextVerseButton"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ctrl_button"
                            android:text="@string/next"
                            android:textAllCaps="false"
                            android:textColor="@color/app_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/verseMatrixScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/panel_bg"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <GridLayout
                            android:id="@+id/verseMatrixGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignMargins"
                            android:gravity="center_vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/navigationBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/app_bg" />

</LinearLayout>
